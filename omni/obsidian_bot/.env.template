# Telegram Bot 配置
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id_here

# Gemini API 密钥
GEMINI_PKM_API_KEY=your_gemini_api_key_here

# 网络代理 (国内服务器访问 Telegram / Gemini API 必填，根据实际端口修改)
HTTP_PROXY=http://192.168.2.9:7890
HTTPS_PROXY=http://192.168.2.9:7890

# Obsidian 仓库 Inbox 路径
OBSIDIAN_INBOX_PATH=/opt/obsidian/vault/Inbox

# Inbox 清理配置 (单位：天)
INBOX_AUTO_PRUNE_DAYS=30
